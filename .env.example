# Copy to .env.local and fill in. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser. Everything else is server-only.

# --- App ---
# development | test | production (independent of NODE_ENV so preview deploys can be "production"-built but "development" configured)
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin ---
# Private URL for the admin dashboard: https://your-site/<ADMIN_PATH>. Never linked anywhere.
# Generate with: openssl rand -hex 16   (16-64 letters, numbers, - or _)
ADMIN_PATH=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security. Never import it into client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Concierge (server-only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Payments (server-only secrets) ---
# paystack | flutterwave | mock (mock: development only, instant success)
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
